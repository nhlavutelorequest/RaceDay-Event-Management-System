@model RaceDay.Web.Models.EventFormVm
@{
    var isNew = Model.EventId == 0;
    ViewData["Title"] = isNew ? "Create Event" : "Edit Event";
}

<div class="page-header">
    <h2 class="mb-1">@(isNew ? "Create Event" : "Edit Event")</h2>
    <p class="mb-0 opacity-75">Fill in the details of your race.</p>
</div>

<div class="card">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <form asp-action="Save" method="post">
            <input type="hidden" asp-for="EventId" />
            <input type="hidden" asp-for="BannerImageUrl" />

            <div class="mb-3">
                <label asp-for="Name" class="form-label">Event name</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">Description</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="EventDate" class="form-label">Date and start time</label>
                    <input asp-for="EventDate" type="datetime-local" class="form-control" />
                    <span asp-validation-for="EventDate" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Location" class="form-label">Location</label>
                    <input asp-for="Location" class="form-control" />
                    <span asp-validation-for="Location" class="text-danger small"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-4">
                    <label asp-for="DistanceKm" class="form-label">Distance (km)</label>
                    <input asp-for="DistanceKm" type="number" step="0.01" class="form-control" />
                    <span asp-validation-for="DistanceKm" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-4">
                    <label asp-for="EventType" class="form-label">Event type</label>
                    <select asp-for="EventType" class="form-select">
                        <option value="">Choose a type...</option>
                        <option value="Run">Run</option>
                        <option value="Walk">Walk</option>
                        <option value="Cycle">Cycle</option>
                    </select>
                    <span asp-validation-for="EventType" class="text-danger small"></span>
                </div>
            </div>

            <button type="submit" class="btn btn-warning">@(isNew ? "Create event" : "Save changes")</button>
            <a asp-action="Index" class="btn btn-outline-dark ms-2">Cancel</a>
        </form>
    </div>
</div>