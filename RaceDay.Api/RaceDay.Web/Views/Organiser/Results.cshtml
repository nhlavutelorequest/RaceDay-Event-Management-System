@model RaceDay.Web.Models.OrgEnrolmentsVm
@{
    ViewData["Title"] = "Results Entry";
}

<div class="page-header">
    <h2 class="mb-1">Results Entry</h2>
    <p class="mb-3 opacity-75">@Model.EventName</p>
    <a asp-controller="ManageEvents" asp-action="Index" class="btn btn-outline-light btn-sm">← Back to events</a>
    <a asp-action="Enrolments" asp-route-eventId="@Model.EventId" class="btn btn-outline-light btn-sm ms-2">View enrolments</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">✅ @TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">⚠️ @TempData["Error"]</div>
}

@if (!Model.Rows.Any())
{
    <div class="card">
        <div class="card-body text-center text-muted py-5">
            Nobody has enrolled in this event yet, so there are no results to capture.
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-body">
            <p class="meta">Enter the finish time (hours:minutes:seconds) and finishing position. A captured result can't be changed.</p>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Participant</th>
                            <th>Category</th>
                            <th>Status</th>
                            <th>Result</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Rows)
                        {
                            <tr>
                                <td><strong>@r.ParticipantName</strong></td>
                                <td>@r.CategoryName</td>
                                <td><partial name="_StatusBadge" model="r.Status" /></td>
                                <td>
                                    @if (r.HasResult)
                                    {
                                        <span class="status-badge status-confirmed">Captured</span>
                                        <span class="ms-2">@r.FinishTime · position @r.FinishPosition</span>
                                    }
                                    else
                                    {
                                        <form asp-action="SaveResult" method="post" class="d-flex flex-wrap gap-2 align-items-center">
                                            <input type="hidden" name="eventId" value="@Model.EventId" />
                                            <input type="hidden" name="enrolmentId" value="@r.EnrolmentId" />
                                            <input type="time" step="1" name="finishTime" class="form-control form-control-sm"
                                                   style="width:140px" required />
                                            <input type="number" min="1" name="finishPosition" class="form-control form-control-sm"
                                                   style="width:110px" placeholder="Position" required />
                                            <button type="submit" class="btn btn-warning btn-sm">Save</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}