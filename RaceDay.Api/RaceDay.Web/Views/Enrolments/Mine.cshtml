@model List<RaceDay.Web.Controllers.MyEnrolmentVm>
@{
    ViewData["Title"] = "My Enrolments";
}

<div class="page-header">
    <h2 class="mb-1">My Enrolments</h2>
    <p class="mb-0 opacity-75">Track the events you've entered.</p>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">✅ @TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">⚠️ @TempData["Error"]</div>
}

@if (!Model.Any())
{
    <div class="card">
        <div class="card-body text-center text-muted py-5">
            You haven't enrolled in any events yet.<br />
            <a asp-controller="Events" asp-action="Index" class="btn btn-warning mt-3">Browse events</a>
        </div>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var e in Model)
        {
            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <h5 class="mb-1">@e.EventName</h5>
                            <partial name="_StatusBadge" model="e.Status" />
                        </div>
                        <div class="meta mb-2">📅 @e.EventDate.ToString("dd MMM yyyy, HH:mm")</div>
                        <div>🏷️ Category: <strong>@e.CategoryName</strong></div>
                        <div class="meta small mt-2">Enrolled @e.EnrolledAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</div>
                    </div>
                </div>
            </div>
        }
    </div>
}