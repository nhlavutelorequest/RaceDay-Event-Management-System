@model RaceDay.Web.Models.RegisterViewModel
@{
    ViewData["Title"] = "Register";
}

<div class="row justify-content-center py-4">
    <div class="col-md-8 col-lg-6">
        <div class="card auth-card">
            <div class="auth-top">
                <div class="auth-icon">🏁</div>
                <h3 class="mb-1">Create your account</h3>
                <p class="mb-0 opacity-75">Join RaceDay and start enrolling in events.</p>
            </div>
            <div class="card-body">
                <form asp-action="Register" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="FullName" class="form-label"></label>
                            <input asp-for="FullName" class="form-control" placeholder="e.g. Thabo Mokoena" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" placeholder="you@example.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label"></label>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="Optional" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Role" class="form-label">I am a</label>
                            <select asp-for="Role" class="form-select">
                                <option value="Participant">Participant (I want to join events)</option>
                                <option value="Organiser">Organiser (I want to host events)</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label"></label>
                            <input asp-for="Password" class="form-control" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label"></label>
                            <input asp-for="ConfirmPassword" class="form-control" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-warning w-100 mt-4">Create account</button>
                </form>
                <p class="text-center mt-3 mb-0 text-muted">
                    Already have an account? <a asp-action="Login">Login</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}