@using Microsoft.AspNetCore.Http
@{
    var userName = Context.Session.GetString("UserName");
    var role = Context.Session.GetString("Role") ?? "";
    var isOrganiser = role.Equals("Organiser", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDay</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark mb-3">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">🏃 RaceDay</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="nav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Events" asp-action="Index">Events</a></li>
                    </ul>
                    <ul class="navbar-nav">
                        @if (string.IsNullOrEmpty(userName))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Login</a></li>
                            <li class="nav-item"><a class="btn btn-warning btn-sm ms-2" asp-controller="Account" asp-action="Register">Register</a></li>
                        }
                        else
                        {
                            if (isOrganiser)
                            {
                                <li class="nav-item"><span class="nav-link"><span class="badge bg-warning text-dark">Organiser</span></span></li>
                            }
                            else
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Enrolments" asp-action="Index">My Enrolments</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Results" asp-action="Mine">My Results</a></li>
                            }
                            <li class="nav-item"><a class="nav-link" asp-controller="Profile" asp-action="Index">Profile</a></li>
                            <li class="nav-item"><span class="nav-link text-warning">Hi, @userName</span></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Logout">Logout</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top text-muted py-3 mt-4">
        <div class="container">&copy; 2026 RaceDay Event Management</div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>