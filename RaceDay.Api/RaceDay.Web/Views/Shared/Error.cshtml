@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}

<div class="card mt-4">
    <div class="card-body text-center py-5">
        <div style="font-size:3.5rem">🛑</div>
        <h2 class="mt-2">Something went wrong</h2>
        <p class="meta">We hit a problem while handling your request. Please try again in a moment.</p>
        <a class="btn btn-warning mt-2" asp-controller="Home" asp-action="Index">Back to home</a>
        <a class="btn btn-outline-dark mt-2 ms-2" asp-controller="Events" asp-action="Index">Browse events</a>
    </div>
</div>